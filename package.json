{
    "name": "@ipregistry/nestjs",
    "version": "1.0.0",
    "description": "Official Ipregistry integration for NestJS: IP geolocation and threat detection with dependency injection, guards, and decorators.",
    "type": "module",
    "private": false,
    "license": "Apache-2.0",
    "author": "Ipregistry <support@ipregistry.co>",
    "homepage": "https://ipregistry.co",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ipregistry/ipregistry-nestjs.git"
    },
    "bugs": {
        "url": "https://github.com/ipregistry/ipregistry-nestjs/issues"
    },
    "keywords": [
        "nestjs",
        "nest",
        "guard",
        "interceptor",
        "middleware",
        "geolocation",
        "ip",
        "ipaddress",
        "ip intelligence",
        "ip geolocation",
        "ipregistry",
        "geoblocking",
        "gdpr",
        "threat-data",
        "typescript"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "typesVersions": {
        "*": {
            "testing": [
                "./dist/testing.d.cts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./testing": {
            "import": {
                "types": "./dist/testing.d.ts",
                "default": "./dist/testing.js"
            },
            "require": {
                "types": "./dist/testing.d.cts",
                "default": "./dist/testing.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist/**",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist/",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|tsx|json|md)\"",
        "prepack": "npm run clean && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ipregistry/client": "^7.0.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0",
        "@nestjs/core": "^10.0.0 || ^11.0.0",
        "reflect-metadata": "^0.1.13 || ^0.2.0",
        "rxjs": "^7.1.0"
    },
    "devDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-fastify": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/node": "^26.1.0",
        "@types/supertest": "^6.0.0",
        "prettier": "^3.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "supertest": "^7.0.0",
        "tsup": "^8.0.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
